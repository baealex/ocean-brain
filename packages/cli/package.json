{
    "name": "ocean-brain",
    "version": "0.13.0",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": "^22.13.0 || >=24.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/baealex/ocean-brain"
    },
    "homepage": "https://github.com/baealex/ocean-brain",
    "bugs": {
        "url": "https://github.com/baealex/ocean-brain/issues"
    },
    "bin": {
        "ocean-brain": "dist/index.js"
    },
    "files": [
        "dist",
        "LICENSE",
        "SBOM.cdx.json",
        "THIRD_PARTY_NOTICES.txt",
        "scripts/postinstall-prisma.mjs",
        "server/dist",
        "server/prisma/schema.prisma",
        "server/prisma/migrations",
        "server/client/dist"
    ],
    "scripts": {
        "dev": "tsx src/index.ts",
        "build": "tsup",
        "postinstall": "node ./scripts/postinstall-prisma.mjs",
        "test": "tsx --test test/**/*.test.ts",
        "test:ci": "tsx --test test/**/*.test.ts",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@prisma/client": "catalog:",
        "graphql": "catalog:",
        "prisma": "catalog:",
        "sqlite-vec": "catalog:"
    },
    "devDependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "commander": "^14.0.3",
        "zod": "^3.25.76"
    },
    "oceanBrain": {
        "mcpCompatibilityVersion": "0.11.0"
    }
}
