{
    "name": "@ocean-brain/server",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "dist/main.js",
    "scripts": {
        "dev": "prisma migrate deploy && prisma generate && tsx watch --clear-screen=false --exclude \"../client/node_modules/**\" dev/main.ts",
        "dev:server": "prisma migrate deploy && prisma generate && node --watch --import tsx src/main.ts",
        "build": "prisma generate && tsup && tsc-alias",
        "start": "node dist/start.js",
        "lint": "biome check .",
        "format": "biome check --write .",
        "test": "node ../../scripts/test/run-server-tests.mjs",
        "test:ci": "node ../../scripts/test/run-server-tests.mjs",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@baejino/auth": "catalog:",
        "@blocknote/core": "catalog:",
        "@fastify/cookie": "catalog:",
        "@fastify/csrf-protection": "catalog:",
        "@fastify/formbody": "catalog:",
        "@fastify/rate-limit": "catalog:",
        "@fastify/session": "catalog:",
        "@fastify/static": "catalog:",
        "@graphql-tools/schema": "catalog:",
        "@graphql-tools/utils": "catalog:",
        "@prisma/client": "catalog:",
        "diff": "catalog:",
        "fastify": "catalog:",
        "graphql": "catalog:",
        "jsdom": "catalog:",
        "mercurius": "catalog:",
        "prisma": "catalog:",
        "sqlite-vec": "catalog:"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.11",
        "@types/jsdom": "^21.1.7",
        "tsc-alias": "^1.9.1",
        "tsup": "^8.5.1",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2",
        "vite": "^7.3.5"
    }
}
