{
    "compilerOptions": {
        "outDir": "dist",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "moduleResolution": "Node16",
        "target": "ES2022",
        "module": "Node16",
        "rootDir": "..",
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "types": ["node"],
        "paths": {
            "~/*": ["./src/*"]
        }
    },
    "include": ["src/**/*", "dev/**/*"],
    "tsx": {
        "tsconfig": "./tsconfig.json"
    }
}
